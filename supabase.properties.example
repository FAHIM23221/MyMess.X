# Copy this file to "supabase.properties" for local builds. That file is git-ignored.
# For GitHub Actions, use repository Secrets instead (see README.md).
# Only the PUBLIC project URL and PUBLIC anon key go here.
# NEVER put the service_role key, database password or any other secret here.
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-PUBLIC-ANON-KEY
